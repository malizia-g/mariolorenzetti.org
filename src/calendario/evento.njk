---
pagination:
  data: events.all
  size: 1
  alias: ev
  addAllPagesToCollections: true
permalink: "{{ ev.url }}"
layout: layouts/base.njk
lang: it
breadcrumbParent: { name: "Calendario", url: "/calendario/" }
eleventyComputed:
  title: "{{ ev.title }} – {{ ev.dateLabel }}"
  seoTitle: "{{ ev.seoTitle }} | Mario Lorenzetti"
  description: "{{ ev.type }} con Mario Lorenzetti a {{ ev.city }}{% if ev.venue %} ({{ ev.venue }}){% endif %}, {{ ev.dateLabel }}. {{ ev.description }}"
  updated: "{{ ev.start }}"
---
{%- set isPast = ev.end < build.today -%}
{%- set country = "FR" if "Francia" in ev.city else ("DE" if "Germania" in ev.city else ("CH" if "Svizzera" in ev.city else "IT")) -%}
{%- set mario = { "@type": "Person", "name": "Mario Lorenzetti", "url": site.url + "/" } -%}
{%- set performers = [mario] -%}
{%- if ev.with %}{% for name in ev.with.split(",") %}{% set _ = performers.push({ "@type": "Person", "name": name | trim }) %}{% endfor %}{% endif -%}
{%- set eventLd = {
  "@type": "Event",
  "name": ev.title,
  "description": ev.description or (ev.type + " di Respirazione Olotropica con Mario Lorenzetti"),
  "startDate": ev.start,
  "endDate": ev.end,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "inLanguage": ev.languageCode,
  "url": ev.url | abs,
  "image": [site.url + "/assets/og-default.jpg"],
  "location": { "@type": "Place", "name": (ev.venue or ev.city), "address": { "@type": "PostalAddress", "addressLocality": ev.city, "addressCountry": country } },
  "organizer": mario,
  "performer": performers
} -%}
<script type="application/ld+json">{{ ({ "@context": "https://schema.org" } | merge(eventLd)) | jsonScript | safe }}</script>
<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16">
  <p class="text-sm font-medium tracking-wide text-clay-600 uppercase"><a href="/calendario/" class="hover:underline">Calendario</a> · {{ ev.type }}</p>
  <h1 class="mt-3 text-4xl leading-tight font-medium md:text-5xl">{{ ev.title }}</h1>
  {%- if isPast %}
  <p class="mt-4 inline-block rounded-full bg-sand-200 px-3 py-1 text-sm">Evento concluso – <a class="underline" href="/calendario/">vedi le prossime date</a></p>
  {%- endif %}

  <dl class="mt-8 grid gap-x-8 gap-y-4 rounded-2xl border border-sand-200 bg-white p-6 sm:grid-cols-2">
    <div><dt class="text-xs font-medium tracking-wide text-ink-soft uppercase">Quando</dt><dd class="mt-1 font-medium"><time datetime="{{ ev.start }}">{{ ev.dateLabel }}</time>{% if ev.time %}<br><span class="font-normal text-ink-soft">{{ ev.time }}</span>{% endif %}</dd></div>
    <div><dt class="text-xs font-medium tracking-wide text-ink-soft uppercase">Dove</dt><dd class="mt-1 font-medium">{{ ev.city }}{% if ev.venue %}<br><span class="font-normal text-ink-soft">{{ ev.venue }}</span>{% endif %}</dd></div>
    <div><dt class="text-xs font-medium tracking-wide text-ink-soft uppercase">Conduce</dt><dd class="mt-1 font-medium">Mario Lorenzetti{% if ev.with %} con {{ ev.with }}{% endif %}</dd></div>
    {%- if ev.deadline or ev.earlyDeadline %}
    <div><dt class="text-xs font-medium tracking-wide text-ink-soft uppercase">Iscrizioni</dt><dd class="mt-1 font-medium">{% if ev.deadline %}entro il {{ ev.deadline | longDate }}{% endif %}{% if ev.earlyDeadline and ev.earlyDeadline != ev.deadline %}<br><span class="font-normal text-ink-soft">anticipata entro il {{ ev.earlyDeadline | longDate }}</span>{% endif %}</dd></div>
    {%- endif %}
    {%- if ev.language and ev.language != "Italiano" %}
    <div><dt class="text-xs font-medium tracking-wide text-ink-soft uppercase">Lingua</dt><dd class="mt-1 font-medium">{{ ev.language }}</dd></div>
    {%- endif %}
  </dl>

  {%- if ev.description %}
  <div class="prose-site mt-8"><p>{{ ev.description }}</p></div>
  {%- endif %}

  {%- if not isPast %}
  <div class="mt-10 rounded-2xl bg-moss-900 p-6 text-sand-100 md:p-8">
    <h2 class="font-serif text-2xl text-white">Come iscriversi</h2>
    <p class="mt-2 text-sand-200/90">Prima dell'iscrizione è necessario compilare un questionario di accettazione. Il numero di posti è limitato.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="/contatti/?evento={{ ev.title | urlencode }}%20({{ ev.dateLabel | urlencode }})" class="btn bg-clay-500 text-white hover:bg-clay-600">Richiedi informazioni</a>
      <a href="{{ site.phoneHref }}" class="btn border border-sand-200/40 text-white hover:bg-white/10">{{ site.phone }}</a>
      {%- if ev.link %}
      <a href="{{ ev.link }}" class="btn border border-sand-200/40 text-white hover:bg-white/10" rel="noopener" target="_blank">{{ "Programma (pdf)" if ".pdf" in ev.link else "Pagina dell'evento" }} ↗</a>
      {%- endif %}
    </div>
  </div>
  {%- elif ev.link %}
  <p class="mt-8"><a href="{{ ev.link }}" rel="noopener" target="_blank" class="btn-ghost">{{ "Programma (pdf)" if ".pdf" in ev.link else "Pagina dell'evento" }} ↗</a></p>
  {%- endif %}

  <p class="mt-10 text-ink-soft">Scopri di più sulla <a class="text-moss-600 underline" href="/respirazione-olotropica/">Respirazione Olotropica</a> e su <a class="text-moss-600 underline" href="/seminari/">come si svolgono i seminari</a>.</p>
</article>
