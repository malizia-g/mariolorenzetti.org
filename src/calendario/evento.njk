---
pagination:
  data: events.all
  size: 1
  alias: ev
  addAllPagesToCollections: true
permalink: "{{ ev.url }}"
layout: layouts/base.njk
lang: it
breadcrumbParent: { name: "Calendario", url: "/calendario/" }
eleventyComputed:
  title: "{{ ev.title }} – {{ ev.dateLabel }}"
  seoTitle: "{{ ev.seoTitle }} | Mario Lorenzetti"
  description: "{{ ev.type }} con Mario Lorenzetti a {{ ev.city }}{% if ev.venue %} ({{ ev.venue }}){% endif %}, {{ ev.dateLabel }}. {{ ev.description }}"
  updated: "{{ ev.start }}"
---
{%- set isPast = ev.end < build.today -%}
{%- set country = "FR" if "Francia" in ev.city else ("DE" if "Germania" in ev.city else ("CH" if "Svizzera" in ev.city else "IT")) -%}
{%- set mario = { "@type": "Person", "name": "Mario Lorenzetti", "url": site.url + "/" } -%}
{%- set performers = [mario] -%}
{%- if ev.with %}{% for name in ev.with.split(",") %}{% set _ = performers.push({ "@type": "Person", "name": name | trim }) %}{% endfor %}{% endif -%}
{%- set eventLd = {
  "@type": "Event",
  "name": ev.title,
  "description": ev.description or (ev.type + " di Respirazione Olotropica con Mario Lorenzetti"),
  "startDate": ev.start,
  "endDate": ev.end,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "inLanguage": ev.languageCode,
  "url": ev.url | abs,
  "image": [site.url + "/assets/og-default.jpg"],
  "location": { "@type": "Place", "name": (ev.venue or ev.city), "address": { "@type": "PostalAddress", "addressLocality": ev.city, "addressCountry": country } },
  "organizer": mario,
  "performer": performers
} -%}
<script type="application/ld+json">{{ ({ "@context": "https://schema.org" } | merge(eventLd)) | jsonScript | safe }}</script>
{%- set kicker = '<a href="/calendario/" class="hover:underline">Calendario</a> · ' + ev.type -%}
{%- set heading = ev.title -%}
{%- set lead = null -%}
{% include "partials/page-header.njk" %}
<article class="mx-auto max-w-4xl px-4 pb-20 sm:px-6">
  {%- if isPast %}
  <p class="mb-8 text-center"><span class="smallcaps inline-block border-[1.5px] border-ink bg-cream px-4 py-2">Evento concluso · <a class="text-sienna underline" href="/calendario/">vedi le prossime date</a></span></p>
  {%- endif %}

  <div class="grid gap-0 border-[1.5px] border-ink bg-cream shadow-[8px_8px_0_var(--color-saffron)] md:grid-cols-[15rem_1fr]">
    <div class="flex flex-col justify-center border-b-[1.5px] border-ink bg-saffron p-6 text-center md:border-r-[1.5px] md:border-b-0">
      <p class="font-display text-7xl leading-none text-ink">{{ ev.ledger.days }}</p>
      <p class="smallcaps mt-3 text-umber">{{ ev.ledger.month }}</p>
      {%- if ev.time %}<p class="mt-3 text-sm text-ink/80 italic">{{ ev.time }}</p>{% endif %}
    </div>
    <dl class="grid gap-5 p-6 sm:grid-cols-2 md:p-8">
      <div><dt class="smallcaps text-umber">Dove</dt><dd class="mt-1 text-lg">{{ ev.city }}{% if ev.venue %}<br><span class="text-ink-soft italic">{{ ev.venue }}</span>{% endif %}</dd></div>
      <div><dt class="smallcaps text-umber">Conduce</dt><dd class="mt-1 text-lg">Mario Lorenzetti{% if ev.with %}<br><span class="text-ink-soft italic">con {{ ev.with }}</span>{% endif %}</dd></div>
      {%- if ev.deadline or ev.earlyDeadline %}
      <div><dt class="smallcaps text-umber">Iscrizioni</dt><dd class="mt-1 text-lg">{% if ev.deadline %}entro il {{ ev.deadline | longDate }}{% endif %}{% if ev.earlyDeadline and ev.earlyDeadline != ev.deadline %}<br><span class="text-ink-soft italic">anticipata entro il {{ ev.earlyDeadline | longDate }}</span>{% endif %}</dd></div>
      {%- endif %}
      {%- if ev.language and ev.language != "Italiano" %}
      <div><dt class="smallcaps text-umber">Lingua</dt><dd class="mt-1 text-lg">{{ ev.language }}</dd></div>
      {%- endif %}
    </dl>
  </div>

  {%- if ev.description %}
  <div class="prose-site mx-auto mt-12 max-w-3xl"><p class="text-xl">{{ ev.description }}</p></div>
  {%- endif %}

  {%- if not isPast %}
  <div class="mt-12 bg-clay p-8 text-cream md:p-10">
    <h2 class="text-3xl text-cream">Come iscriversi</h2>
    <p class="mt-3 max-w-2xl text-saffron-soft italic">Prima dell'iscrizione è necessario compilare un questionario di accettazione. Il numero di posti è limitato.</p>
    <div class="mt-7 flex flex-wrap gap-4">
      <a href="/contatti/?evento={{ ev.title | urlencode }}%20({{ ev.dateLabel | urlencode }})" class="btn border-saffron bg-saffron text-ink [box-shadow:4px_4px_0_var(--color-cream)] hover:[box-shadow:6px_6px_0_var(--color-cream)]">Richiedi informazioni →</a>
      <a href="{{ site.phoneHref }}" class="btn border-cream bg-transparent text-cream [box-shadow:4px_4px_0_var(--color-saffron)] hover:[box-shadow:6px_6px_0_var(--color-saffron)]">{{ site.phone }}</a>
      {%- if ev.link %}
      <a href="{{ ev.link }}" class="btn border-cream bg-transparent text-cream [box-shadow:4px_4px_0_var(--color-saffron)] hover:[box-shadow:6px_6px_0_var(--color-saffron)]" rel="noopener" target="_blank">{{ "Programma (pdf)" if ".pdf" in ev.link else "Pagina dell'evento" }} ↗</a>
      {%- endif %}
    </div>
  </div>
  {%- elif ev.link %}
  <p class="mt-10 text-center"><a href="{{ ev.link }}" rel="noopener" target="_blank" class="btn-ghost">{{ "Programma (pdf)" if ".pdf" in ev.link else "Pagina dell'evento" }} ↗</a></p>
  {%- endif %}

  <p class="mt-12 text-center text-ink-soft italic">Scopri di più sulla <a class="text-sienna underline underline-offset-4" href="/respirazione-olotropica/">Respirazione Olotropica</a> e su <a class="text-sienna underline underline-offset-4" href="/seminari/">come si svolgono i seminari</a>.</p>
</article>
