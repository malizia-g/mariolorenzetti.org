Options -Indexes
DirectoryIndex index.html index.php index.xml
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS e dominio senza www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mariolorenzetti.org%{REQUEST_URI} [R=301,L]

# Vecchi shortlink WordPress ?p=ID / ?page_id=ID
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=6(&|$)
RewriteRule ^$ /? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=13(&|$)
RewriteRule ^$ /respirazione-olotropica/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=18(&|$)
RewriteRule ^$ /cerchi-sciamanici/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=26(&|$)
RewriteRule ^$ /counseling/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=28(&|$)
RewriteRule ^$ /contatti/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=35(&|$)
RewriteRule ^$ /ecopsicologia/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=54(&|$)
RewriteRule ^$ /seminari/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=160(&|$)
RewriteRule ^$ /emergenze-spirituali/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=221(&|$)
RewriteRule ^$ /respirazione-olotropica-e-via-sciamanica/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=249(&|$)
RewriteRule ^$ /pubblicazioni/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=259(&|$)
RewriteRule ^$ /giornata-sciamanica-sugli-archetipi-delle-direzioni-e-la-ruota-di-medicina/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=279(&|$)
RewriteRule ^$ /intervista-a-mario-lorenzetti-da-parte-di-macro-edizioni/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=(711|360)(&|$)
RewriteRule ^$ /calendario/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=835(&|$)
RewriteRule ^$ /counseling/il-counseling-transpersonale-e-corporeo-e-il-mio-approccio/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=563(&|$)
RewriteRule ^$ /la-respirazione-olotropica-e-il-potenziale-di-guarigione-degli-stati-non-ordinari-di-coscienza/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=571(&|$)
RewriteRule ^$ /prefazione-al-libro-di-c-michael-smith-jung-e-lo-sciamanesimo-amrita-edizioni-2018/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=591(&|$)
RewriteRule ^$ /prefazione-al-libro-di-daniele-petitto-aromaterapia-totemica/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=749(&|$)
RewriteRule ^$ /fr/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=67(&|$)
RewriteRule ^$ /fr/respiration-holotropique/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=304(&|$)
RewriteRule ^$ /fr/respiration-holotropique-et-voie-chamanique/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=63(&|$)
RewriteRule ^$ /fr/stages/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=69(&|$)
RewriteRule ^$ /fr/contacts/? [R=301,L]
# Ricerca WordPress
RewriteCond %{QUERY_STRING} (^|&)s=
RewriteRule ^$ /? [R=301,L]

# Vecchio post-archivio del calendario (ora sul Google Sheet)
RewriteRule ^seminari-di-respirazione-olotropica-intensivi/?$ /calendario/ [R=301,L]

# Archivi WordPress
RewriteRule ^category/pubblicazioni-di-mario-lorenzetti/?(.*)$ /scritti/ [R=301,L]
RewriteRule ^category/calendario-dei-seminari/?(.*)$ /calendario/ [R=301,L]
RewriteRule ^category/ / [R=301,L]
RewriteRule ^(fr/)?author/ /$1 [R=301,L]
RewriteRule ^(fr/)?tag/ /$1 [R=301,L]
RewriteRule ^(fr/)?page/[0-9]+/?$ /$1 [R=301,L]
RewriteRule ^(fr/)?[0-9]{4}(/[0-9]{2})?(/[0-9]{2})?/?$ /$1 [R=301,L]

# Feed e sitemap WordPress
RewriteRule ^fr/feed/?$ /feed/ [R=301,L]
RewriteRule ^comments/feed/?$ /feed/ [R=301,L]
RewriteRule ^.+/feed/?$ /feed/ [R=301,L]
RewriteRule ^(fr/)?(wp-sitemap|sitemap_index|sitemap-home|sitemap-posts|sitemap-pages)[^/]*\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^fr/sitemap\.xml$ /sitemap.xml [R=301,L]

# Percorsi WordPress che non esistono più
RewriteRule ^(wp-admin|wp-includes|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup)\.php$ - [G,L]

# Slash finale (come in WordPress) per le pagine
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z0-9]{2,5}|/)$ [NC]
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# /img/ e i font hanno nomi con hash: cache lunga. Il resto: una settimana.
<FilesMatch "\.(woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(avif|webp|jpe?g|png|svg|css|pdf)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(html|xml)$">
  Header set Cache-Control "public, max-age=300"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<Files "index.xml">
  ForceType application/rss+xml
</Files>
