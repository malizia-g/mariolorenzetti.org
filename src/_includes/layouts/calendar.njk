---
layout: layouts/base.njk
---
{% include "partials/page-header.njk" %}

<section class="bg-clay text-cream" aria-labelledby="prossime">
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-16 sm:px-6">
    <h2 id="prossime" class="border-b border-cream/25 pb-5 text-4xl text-cream">{{ i18n[lang].upcoming }}</h2>
    {%- if events.upcoming.length %}
    <ul class="grid md:grid-cols-3 md:divide-x md:divide-cream/25">
      {%- for ev in events.upcoming %}<li class="border-b border-cream/25 md:border-b-0">{% set dark = true %}{% include "partials/event-card.njk" %}</li>{% endfor %}
    </ul>
    {%- else %}
    <p class="mt-6 text-saffron-soft italic">Le nuove date saranno pubblicate a breve. Iscriviti alla newsletter per essere avvisato.</p>
    {%- endif %}
  </div>
</section>

<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
  <div class="prose-site">
    {{ content | safe }}
  </div>
</div>

{%- if events.pastByYear.length %}
<section class="border-t border-ink/15 bg-cream/60" aria-labelledby="passate">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h2 id="passate" class="text-4xl">Iniziative passate</h2>
    {%- for group in events.pastByYear %}
    <div class="mt-10 grid gap-2 md:grid-cols-[8rem_1fr]">
      <h3 class="font-display text-3xl text-ochre">{{ group.year }}</h3>
      <ul class="divide-y divide-ink/10 border-y border-ink/10">
        {%- for ev in group.events %}
        <li><a href="{{ ev.url }}" class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-6"><time class="smallcaps w-48 shrink-0 text-umber" datetime="{{ ev.start }}">{{ ev.dateLabel }}</time><span class="group-hover:text-sienna">{{ ev.title }}{% if ev.venue %} <span class="text-ink-soft italic">· {{ ev.venue }}</span>{% endif %}</span></a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
</section>
{%- endif %}
