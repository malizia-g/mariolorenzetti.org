---
layout: layouts/base.njk
---
<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
  <header class="max-w-3xl">
    <h1 class="text-4xl leading-tight font-medium md:text-5xl">{{ title }}</h1>
    {%- if lead %}<p class="mt-4 text-xl text-ink-soft">{{ lead }}</p>{% endif %}
  </header>

  <section class="mt-12" aria-labelledby="prossime">
    <h2 id="prossime" class="text-3xl font-medium">{{ i18n[lang].upcoming }}</h2>
    {%- if events.upcoming.length %}
    <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {%- for ev in events.upcoming %}<li>{% include "partials/event-card.njk" %}</li>{% endfor %}
    </ul>
    {%- else %}
    <p class="mt-4 text-ink-soft">Le nuove date saranno pubblicate a breve. Iscriviti alla newsletter per essere avvisato.</p>
    {%- endif %}
  </section>

  <div class="prose-site mt-14 max-w-3xl">
    {{ content | safe }}
  </div>

  {%- if events.pastByYear.length %}
  <section class="mt-16" aria-labelledby="passate">
    <h2 id="passate" class="text-3xl font-medium">Iniziative passate</h2>
    {%- for group in events.pastByYear %}
    <h3 class="mt-8 font-sans text-sm font-semibold tracking-widest text-ink-soft uppercase">{{ group.year }}</h3>
    <ul class="mt-3 divide-y divide-sand-200 border-y border-sand-200">
      {%- for ev in group.events %}
      <li><a href="{{ ev.url }}" class="flex flex-col gap-1 py-3 hover:text-moss-600 sm:flex-row sm:gap-6"><time class="w-52 shrink-0 text-ink-soft" datetime="{{ ev.start }}">{{ ev.dateLabel }}</time><span>{{ ev.title }}{% if ev.venue %} <span class="text-ink-soft">· {{ ev.venue }}</span>{% endif %}</span></a></li>
      {%- endfor %}
    </ul>
    {%- endfor %}
  </section>
  {%- endif %}
</div>
