---
layout: layouts/base.njk
breadcrumbParent: { name: "Scritti", url: "/scritti/" }
---
<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16">
  <header class="mb-10">
    <p class="text-sm font-medium tracking-wide text-clay-600 uppercase"><a href="/scritti/" class="hover:underline">Scritti</a></p>
    <h1 class="mt-3 text-4xl leading-tight font-medium md:text-5xl">{{ title }}</h1>
    <p class="mt-4 text-ink-soft">{{ i18n[lang].published }} <time datetime="{{ page.date | isoDate }}">{{ page.date | longDate(lang) }}</time> · Mario Lorenzetti</p>
  </header>
  <div class="prose-site">
    {{ content | safe }}
  </div>
</article>
