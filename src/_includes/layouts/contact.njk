---
layout: layouts/base.njk
turnstile: true
---
{%- set fr = lang == "fr" -%}
{% include "partials/page-header.njk" %}
{# Conferma newsletter: compare solo arrivando dal link nell'email (?e=…&n=…&s=…). #}
<div class="px-4 sm:px-6"><form id="iscrizione" action="/api/newsletter" method="post" hidden class="mx-auto mb-12 max-w-3xl border-[1.5px] border-ink bg-saffron-soft p-6 shadow-[8px_8px_0_var(--color-ink)] md:p-8">
  <input type="hidden" name="lang" value="{{ lang }}">
  <input type="hidden" name="e"><input type="hidden" name="n"><input type="hidden" name="s">
  <h2 class="font-display text-3xl">Newsletter</h2>
  <p class="mt-2 text-lg">{% if fr %}Confirmez l'inscription de <b data-email></b> à la newsletter de Mario Lorenzetti.{% else %}Conferma l'iscrizione di <b data-email></b> alla newsletter di Mario Lorenzetti.{% endif %}</p>
  <p data-esito role="status" class="mt-4 hidden"></p>
  <button type="submit" class="btn-primary mt-6">{{ "Confirmer l'inscription" if fr else "Conferma l'iscrizione" }}</button>
</form></div>
<div class="mx-auto grid max-w-6xl gap-12 px-4 pb-20 sm:px-6 md:grid-cols-[1fr_1.3fr]">
  <div>
    <dl class="space-y-6">
      <div><dt class="smallcaps text-umber">{{ "Téléphone" if fr else "Telefono" }}</dt><dd class="mt-1 font-display text-3xl"><a class="hover:text-sienna" href="{{ site.phoneHref }}">{{ site.phone }}</a></dd></div>
      <div><dt class="smallcaps text-umber">Email</dt><dd class="mt-1 font-display text-2xl break-all"><a class="hover:text-sienna" href="mailto:{{ site.email }}">{{ site.email }}</a></dd></div>
    </dl>
    <div class="prose-site mt-8">{{ content | safe }}</div>
  </div>

  <form id="contatto" action="/api/contatto" method="post" class="relative space-y-5 border-[1.5px] border-ink bg-cream p-6 shadow-[8px_8px_0_var(--color-saffron)] md:p-8">
    <p id="esito" role="status" class="hidden p-4"></p>
    <input type="hidden" name="lang" value="{{ lang }}">
    <input type="hidden" name="t" value="">
    {# Honeypot: invisibile alle persone, i bot lo compilano. #}
    <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
    <div>
      <label for="nome" class="smallcaps block text-umber">{{ "Nom" if fr else "Nome" }} *</label>
      <input id="nome" name="nome" required autocomplete="name" class="mt-1 w-full border-0 border-b-[1.5px] border-ink/40 bg-transparent px-0 py-2 text-lg focus:border-sienna focus:ring-0 focus:outline-none">
    </div>
    <div>
      <label for="email" class="smallcaps block text-umber">Email *</label>
      <input id="email" name="email" type="email" required autocomplete="email" class="mt-1 w-full border-0 border-b-[1.5px] border-ink/40 bg-transparent px-0 py-2 text-lg focus:border-sienna focus:ring-0 focus:outline-none">
    </div>
    <div>
      <label for="oggetto" class="smallcaps block text-umber">{{ "Objet" if fr else "Oggetto" }}</label>
      <input id="oggetto" name="oggetto" class="mt-1 w-full border-0 border-b-[1.5px] border-ink/40 bg-transparent px-0 py-2 text-lg focus:border-sienna focus:ring-0 focus:outline-none">
    </div>
    <div>
      <label for="messaggio" class="smallcaps block text-umber">{{ "Message" if fr else "Messaggio" }} *</label>
      <textarea id="messaggio" name="messaggio" rows="6" required class="mt-1 w-full border-0 border-b-[1.5px] border-ink/40 bg-transparent px-0 py-2 text-lg focus:border-sienna focus:ring-0 focus:outline-none"></textarea>
    </div>
    <label class="flex items-start gap-3 text-ink-soft">
      <input type="checkbox" name="privacy" value="1" required class="mt-1 accent-sienna">
      <span>{% if fr %}J'accepte le traitement de mes données selon la <a class="underline" href="{{ site.privacyUrl }}" target="_blank" rel="noopener">politique de confidentialité</a>.{% else %}Acconsento al trattamento dei dati secondo l'<a class="underline" href="{{ site.privacyUrl }}" target="_blank" rel="noopener">informativa privacy</a>.{% endif %} *</span>
    </label>
    <label class="flex items-start gap-3 text-ink-soft">
      <input type="checkbox" name="newsletter" value="1" class="mt-1 accent-sienna">
      <span>{% if fr %}Je souhaite recevoir la newsletter avec les nouvelles dates (je recevrai un email pour confirmer).{% else %}Voglio ricevere la newsletter con le nuove date (riceverò un'email per confermare).{% endif %}</span>
    </label>
    {# Turnstile a fianco del pulsante; su mobile va sotto. #}
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap">
      {#- 65px: l'altezza fissa del widget Turnstile. #}
      <button type="submit" class="btn-primary justify-center sm:h-[65px]">{{ "Envoyer" if fr else "Invia messaggio" }}</button>
      {%- if site.turnstileSiteKey %}
      <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-language="{{ lang }}" data-theme="light"></div>
      {%- endif %}
    </div>
  </form>
</div>
<script>
  (() => {
    const form = document.getElementById("contatto");
    const esito = document.getElementById("esito");
    const params = new URLSearchParams(location.search);
    form.t.value = Date.now();
    if (params.get("evento")) form.oggetto.value = params.get("evento");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button");
      btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const data = await res.json();
        esito.textContent = data.message;
        esito.className = "p-4 border-[1.5px] border-ink " + (data.ok ? "bg-saffron-soft" : "bg-cream text-sienna");
        if (data.ok) form.reset();
      } catch {
        esito.textContent = "{{ 'Erreur. Écrivez directement à ' if fr else 'Errore di invio. Scrivi direttamente a ' }}{{ site.email }}";
        esito.className = "p-4 border-[1.5px] border-ink bg-cream text-sienna";
      }
      // Il token Turnstile vale per un solo invio: ne serve uno nuovo per il prossimo.
      window.turnstile?.reset();
      btn.disabled = false;
    });

    const iscr = document.getElementById("iscrizione");
    if (params.get("e") && params.get("s")) {
      for (const k of ["e", "n", "s"]) iscr[k].value = params.get(k) || "";
      iscr.querySelector("[data-email]").textContent = params.get("e");
      iscr.hidden = false;
      iscr.scrollIntoView();
      iscr.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = iscr.querySelector("button");
        const out = iscr.querySelector("[data-esito]");
        btn.disabled = true;
        let data;
        try {
          data = await (await fetch(iscr.action, { method: "POST", body: new FormData(iscr) })).json();
        } catch {
          data = { ok: false, message: "{{ 'Erreur. Réessayez plus tard.' if fr else 'Errore. Riprova più tardi.' }}" };
        }
        out.textContent = data.message;
        out.className = "mt-4 text-lg " + (data.ok ? "font-bold" : "text-sienna");
        if (data.ok) { btn.hidden = true; history.replaceState(null, "", location.pathname); }
        else btn.disabled = false;
      });
    }
  })();
</script>
