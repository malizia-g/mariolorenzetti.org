{%- set t = i18n[lang] -%}
<section class="border-t border-sand-200 bg-moss-900 text-sand-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <h2 class="font-serif text-2xl text-white">{{ t.newsletterTitle }}</h2>
      <p class="mt-2 text-sand-200/80">{{ t.newsletterText }}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="{{ site.newsletter.it }}" class="btn bg-clay-500 text-white hover:bg-clay-600" rel="noopener" target="_blank">{{ t.newsletterIt }}</a>
        <a href="{{ site.newsletter.fr }}" class="btn border border-sand-200/40 text-white hover:bg-white/10" rel="noopener" target="_blank">{{ t.newsletterFr }}</a>
      </div>
    </div>
    <div>
      <h2 class="font-serif text-2xl text-white">{{ t.booksTitle }}</h2>
      <ul class="mt-3 space-y-2 text-sand-200/90">
        <li><a class="underline decoration-sand-200/30 underline-offset-4 hover:text-white" href="/wp-content/uploads/2022/09/L_esperienza-della-kundalini.pdf">L'esperienza della kundalini (pdf)</a></li>
        <li><a class="underline decoration-sand-200/30 underline-offset-4 hover:text-white" href="/wp-content/uploads/2022/07/Tempestosa-ricerca-di-se.pdf">Tempestosa ricerca di sé (pdf)</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-serif text-2xl text-white">{{ t.contact }}</h2>
      <ul class="mt-3 space-y-2 text-sand-200/90">
        <li><a class="hover:text-white" href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li><a class="hover:text-white" href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a class="hover:text-white" href="{{ site.social.facebookPage }}" rel="noopener" target="_blank">Facebook – Olotropica e sciamanismo</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm text-sand-200/70 sm:px-6">
      <p>© {{ build.year }} Mario Lorenzetti</p>
      <p class="flex gap-4">
        <a class="hover:text-white" href="{{ site.privacyUrl }}" rel="noopener">{{ t.privacy }}</a>
        <a class="hover:text-white" href="/feed/">RSS</a>
      </p>
    </div>
  </div>
</section>
