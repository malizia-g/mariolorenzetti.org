{#- Evento in stile agenda: giorni in grande, mese in maiuscoletto. `dark` = su fondo scuro. -#}
<a href="{{ ev.url }}" class="group block h-full px-1 py-8 md:px-8 {% if loop and loop.first %}md:pl-0{% endif %}">
  <p class="flex items-baseline gap-3">
    <span class="font-display text-6xl leading-none {{ 'text-saffron' if dark else 'text-sienna' }}">{{ ev.ledger.days }}</span>
    <span class="smallcaps {{ 'text-saffron-soft' if dark else 'text-umber' }}">{{ ev.ledger.month }}</span>
  </p>
  <h3 class="mt-4 text-2xl leading-snug {{ 'text-cream' if dark else 'text-ink' }} decoration-saffron decoration-2 underline-offset-4 group-hover:underline">{{ ev.title }}</h3>
  <p class="mt-2 {{ 'text-cream/85' if dark else 'text-ink-soft' }} italic">
    {{ ev.city }}{% if ev.venue %} · {{ ev.venue }}{% endif %}{% if ev.with %} — con {{ ev.with }}{% endif %}
  </p>
  <p class="smallcaps mt-4 {{ 'text-saffron-soft/80' if dark else 'text-umber' }}">{{ ev.type }}</p>
</a>
