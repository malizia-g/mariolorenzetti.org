{
  "name": "mariolorenzetti.org",
  "version": "1.0.0",
  "description": "Sito di Mario Lorenzetti – Respirazione Olotropica (11ty)",
  "scripts": {
    "clean": "rm -rf _site",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./_site/css/main.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run clean && npm run build:eleventy && npm run build:css",
    "watch:css": "tailwindcss -i ./src/styles/main.css -o ./_site/css/main.css --watch",
    "watch:eleventy": "eleventy --serve",
    "dev": "npm-run-all --parallel watch:*",
    "start": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malizia-g/mariolorenzetti.org.git"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/malizia-g/mariolorenzetti.org/issues"
  },
  "homepage": "https://github.com/malizia-g/mariolorenzetti.org#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "markdown-it": "^15.0.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
